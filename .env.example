# LLM of the game (optional). Copy to .env and fill in. The key stays on the server (vite dev/preview or `npm run serve`), never in the browser.
# OVERSEER_LLM: off (default) · fake (answers from tests/fixtures/llm/tool.json) · deepseek (real, costs money)
OVERSEER_LLM=off
# OVERSEER_LLM_POINTS_OFF=command,director   (points to shut) · OVERSEER_LLM_DAILY=20000 (requests a day for the server)
DEEPSEEK_API_KEY=
# deepseek-flash = DeepSeek-V4.1-Flash-1017 (https://api-docs.deepseek.com/quick_start/pricing)
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
