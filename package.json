{
  "name": "isekai-god-sim",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "serve": "vite build && tsx server/main.ts",
    "typecheck": "tsc --noEmit",
    "docs:check": "node scripts/docs/check-docs.mjs",
    "docs:build": "node scripts/docs/build-weapon-catalog.mjs && node scripts/docs/build-item-catalog.mjs && node scripts/docs/build-npc-map.mjs && node scripts/docs/build-story-map.mjs && node scripts/docs/build-storyline-balance.mjs && node scripts/docs/build-local-events.mjs && node scripts/docs/build-event-coverage.mjs && node scripts/docs/build-country-links.mjs && node scripts/docs/build-npc-economy.mjs && node scripts/docs/build-docs-manifest.mjs",
    "docs:verify": "npm run docs:check && npm run docs:build && tsx scripts/codegen/run-all.ts --check",
    "sim:world": "node scripts/sim/sim-world.mjs",
    "sim:items": "node scripts/sim/sim-items.mjs",
    "sim:god": "node scripts/sim/sim-god.mjs",
    "sim:attention": "node scripts/sim/sim-attention.mjs",
    "test:llm": "node scripts/llm/test-deepseek.mjs",
    "build:library": "node scripts/llm/build-library.mjs",
    "check:library": "node scripts/llm/check-library.mjs",
    "test": "vitest run",
    "test:golden": "vitest run --config vitest.golden.config.ts",
    "test:balance": "vitest run --config vitest.balance.config.ts",
    "gen": "tsx scripts/codegen/run-all.ts",
    "check:looks": "tsx scripts/tools/check-looks.ts",
    "life": "tsx scripts/tools/life.ts",
    "play": "tsx scripts/tools/play.ts"
  },
  "dependencies": {
    "@preact/signals": "^1.3.4",
    "phaser": "3.90.0",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.19.4",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.7"
  }
}
